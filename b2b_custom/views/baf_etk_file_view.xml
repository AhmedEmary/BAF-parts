<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_baf_etk_file_list" model="ir.ui.view">
        <field name="name">baf.etk.file.list</field>
        <field name="model">baf.etk.file</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc, id desc">
                <field name="family_id"/>
                <field name="name"/>
                <field name="file_name"/>
                <field name="create_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_baf_etk_file_form" model="ir.ui.view">
        <field name="name">baf.etk.file.form</field>
        <field name="model">baf.etk.file</field>
        <field name="arch" type="xml">
            <form string="ETK File">
                <sheet>
                    <group>
                        <field name="family_id"/>
                        <field name="name" placeholder="e.g. ETK BMW/MINI"/>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        One ETK file per brand family. To publish a new
                        version, replace the file on this record — every B2B
                        customer entitled to this family downloads it from
                        /pricefile.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_baf_etk_file" model="ir.actions.act_window">
        <field name="name">ETK File</field>
        <field name="res_model">baf.etk.file</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_baf_etk_file"
              name="ETK File"
              parent="sale.prod_config_main"
              action="action_baf_etk_file"
              sequence="90"/>
</odoo>
