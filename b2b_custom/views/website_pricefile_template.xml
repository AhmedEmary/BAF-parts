<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-nav entry. group_ids restricts it to logged-in users (portal
         customers + internal staff); public visitors never see it, so the
         "logged-in only" rule holds at the menu level too, not just at the
         route gate in ir_http. -->
    <record id="menu_pricefile" model="website.menu">
        <field name="name">Preisliste</field>
        <field name="url">/pricefile</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="50"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_portal'), ref('base.group_user')])]"/>
    </record>

    <template id="pricefile_page" name="Price Files">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <h1 class="mb-3">Preisdateien</h1>
                <t t-if="brands">
                    <p class="text-muted">
                        Wählen Sie eine Marke und laden Sie die aktuelle Preisliste als CSV-Datei herunter.
                    </p>
                    <form action="/pricefile/download" method="get" class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label for="brand_id" class="form-label">Marke</label>
                            <select name="brand_id" id="brand_id" class="form-select">
                                <t t-foreach="brands" t-as="brand">
                                    <option t-att-value="brand.id" t-esc="brand.display_name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">CSV herunterladen</button>
                        </div>
                    </form>
                    <t t-if="families">
                        <hr class="my-4"/>
                        <h2 class="h4 mb-2">Kombinierte Preisdatei je Markengruppe</h2>
                        <p class="text-muted">
                            Eine Datei pro Markengruppe (z. B. BMW/MINI oder
                            Jaguar &amp; Land Rover), die alle Marken der Gruppe
                            zusammenfasst.
                        </p>
                        <form action="/pricefile/family/download" method="get" class="row g-2 align-items-end">
                            <div class="col-auto">
                                <label for="family_id" class="form-label">Markengruppe</label>
                                <select name="family_id" id="family_id" class="form-select">
                                    <t t-foreach="families" t-as="family">
                                        <option t-att-value="family.id" t-esc="family.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">CSV herunterladen</button>
                            </div>
                        </form>
                    </t>
                    <hr class="my-4"/>
                    <h2 class="h4 mb-2">Rabattcodes</h2>
                    <p class="text-muted">
                        Alle für Ihr Konto geltenden Verkaufs-Rabattcodes für Ihre
                        Marken als Excel-Datei (ein Arbeitsblatt pro Marke).
                    </p>
                    <a href="/pricefile/discount-download" class="btn btn-outline-primary">
                        Rabattcodes herunterladen (XLSX)
                    </a>
                    <t t-if="etk_available">
                        <hr class="my-4"/>
                        <h2 class="h4 mb-2">ETK</h2>
                        <p class="text-muted">
                            Die aktuelle ETK-Datei ist für alle B2B-Kunden identisch
                            und wird zentral aktualisiert.
                        </p>
                        <a href="/pricefile/etk" class="btn btn-outline-primary">
                            ETK herunterladen
                        </a>
                    </t>
                </t>
                <t t-else="">
                    <div class="alert alert-info">
                        Für Ihr Konto sind derzeit keine Marken freigegeben.
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
