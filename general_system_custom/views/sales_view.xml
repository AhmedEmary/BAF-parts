<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.intelliwise.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            
            <div name="button_box" position="inside">
                <button name="action_view_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="purchase_count == 0">
                    <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
                </button>
                
                <button name="action_view_pallets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="pallet_count == 0">
                    <field name="pallet_count" widget="statinfo" string="Pallets"/>
                </button>
            </div>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="b2b_so" placeholder="Enter B2B SO"/>
                <field name="so_source"/>
                <field name="shipping_method" placeholder="Select shipping method"/>
                <field name="customer_po" placeholder="Enter customer PO number"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <div class="mb-2">
                    <button name="%(action_import_so_lines)d"
                            string="Import Lines from Excel"
                            type="action"
                            class="btn btn-secondary"
                            icon="fa-upload"/>
                    <button name="%(action_open_all_sale_order_lines)d"
                            string="Open Lines in List"
                            type="action"
                            class="btn btn-secondary ms-3"
                            icon="fa-external-link"
                            help="Open all lines in a full list view to multi-select and run bulk actions."/>
                </div>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="update_all_sale_line_reserved_qty"
                        string="Update Reservation"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ['draft', 'sent', 'sale']"/>

                <button name="%(action_sale_line_coverage_report)d" 
                        string="View Coverage Chart" 
                        type="action" 
                        class="btn-secondary" 
                        invisible="state not in ['draft', 'sent', 'sale']"/>

                <button name="%(action_open_lines_to_purchase)d" 
                        string="Select Items to Buy" 
                        type="action" 
                        class="btn-secondary" 
                        invisible="state not in ['sent', 'sale']"/>
                
            </xpath>
            
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="coverage_percentage" widget="progressbar" optional="show" decoration-success="coverage_percentage == 100"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="purchase_vendor_id" string="Selected Vendor" optional="show"
                       domain="[('baf_purchase_method','!=',False)]"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='purchase_price']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='margin']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="invisible">baf_cost_status != 'ok'</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='margin_percent']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="invisible">price_subtotal == 0 or baf_cost_status != 'ok'</attribute>
            </xpath>
            <!-- sale_margin renders "Margin <value> (<pct>)" after tax_totals.
                 Hide it whenever a line has no cost: the sum silently omits
                 those lines, so the total would read as complete. -->
            <xpath expr="//label[@for='margin']/.." position="attributes">
                <attribute name="invisible">baf_cost_gap_count &gt; 0</attribute>
                <attribute name="groups">base.group_user</attribute>
            </xpath>
            <xpath expr="//label[@for='margin']/.." position="after">
                <div class="d-flex float-end text-danger" groups="base.group_user"
                     invisible="baf_cost_gap_count == 0">
                    <field name="baf_cost_gap_count" invisible="1"/>
                    <field name="baf_cost_gap_summary" nolabel="1" readonly="1" class="oe_inline"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='margin_percent']" position="after">
                <field name="baf_cost_status" optional="show" widget="badge"
                       decoration-danger="baf_cost_status in ('no_vendor', 'no_price', 'no_delivery_window')"
                       decoration-muted="baf_cost_status in ('legacy', 'none')"/>
            </xpath>

        </field>
    </record>

    <record id="sale_order_view_tree" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.intelliwise.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="so_source"/>
                <field name="customer_po" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_server_export_so_excel" model="ir.actions.server">
        <field name="name">Export to Excel</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_so_excel()
        </field>
    </record>

    <record id="action_server_export_transaction_report" model="ir.actions.server">
        <field name="name">Export Transaction/Tax Report (Excel)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_transaction_report_excel()
        </field>
    </record>

</odoo>
