<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_tree_contact_number" model="ir.ui.view">
        <field name="name">res.partner.list.baf.contact.number</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Contacts by Number">
                <field name="contact_number"/>
                <field name="name"/>
                <field name="parent_id" optional="hide"/>
                <field name="baf_alt_account_number" optional="show"/>
                <field name="vat" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="city" optional="show"/>
                <field name="country_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_partner_search_contact_number" model="ir.ui.view">
        <field name="name">res.partner.search.baf.contact.number</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Contacts by Number">
                <field name="contact_number"
                       filter_domain="['|', ('contact_number','ilike',self), ('name','ilike',self)]"/>
                <field name="baf_alt_account_number"/>
                <field name="vat"/>
                <field name="email"/>
                <field name="country_id"/>
                <separator/>
                <filter name="companies" string="Companies"
                        domain="[('is_company','=',True)]"/>
                <filter name="individuals" string="Individuals"
                        domain="[('is_company','=',False)]"/>
                <separator/>
                <filter name="vendors" string="Vendors"
                        domain="[('baf_is_vendor','=',True)]"/>
                <filter name="not_vendors" string="Not Vendors"
                        domain="[('baf_is_vendor','=',False)]"/>
                <separator/>
                <filter name="with_express" string="Has Express Number"
                        domain="[('baf_alt_account_number','!=',False)]"/>
                <group name="group_by">
                    <filter name="group_country" string="Country"
                            context="{'group_by': 'country_id'}"/>
                    <filter name="group_vendor" string="Vendor / Customer"
                            context="{'group_by': 'baf_is_vendor'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_baf_contacts_by_number" model="ir.actions.act_window">
        <field name="name">Contacts by Number</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_partner_tree_contact_number"/>
        <field name="search_view_id" ref="view_partner_search_contact_number"/>
        <field name="domain">[('contact_number', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No contacts with a contact number yet</p>
            <p>Only the commercial partner (company or standalone person) receives a contact number — vendor or customer. Child contacts under a company share the company's number.</p>
        </field>
    </record>

    <menuitem id="menu_baf_contacts_by_number"
              name="Contacts by Number"
              parent="contacts.menu_contacts"
              action="action_baf_contacts_by_number"
              sequence="45"/>

    <record id="view_partner_tree_inherit_contact_number" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.baf.contact.number</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='avatar_128']" position="after">
                <field name="contact_number"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_trusted_vendor" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.baf</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="contact_number"/>
                <label for="baf_alt_account_number"/>
                <div class="o_row">
                    <field name="baf_alt_account_number" nolabel="1"
                           placeholder="E.g. E1BF"/>
                    <button name="action_baf_assign_express_account_number"
                            type="object" string="Assign Next"
                            class="btn-link" icon="fa-magic"
                            invisible="baf_alt_account_number"/>
                </div>
            </xpath>

            <div name="button_box" position="inside">
                <button name="action_baf_view_direct_prices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tags"
                        invisible="baf_purchase_method != 'direct'">
                    <field name="baf_direct_price_count" widget="statinfo"
                           string="Direct Prices"/>
                </button>
            </div>

            <!-- Vendor-only settings: hide the whole Purchase block (Buyer,
                 Group RFQ, Vendor Payment Terms, Payment Method, Receipt
                 Reminder) until the contact is marked as a vendor. -->
            <xpath expr="//page[@name='sales_purchases']//group[@name='purchase']" position="attributes">
                <attribute name="invisible">not baf_is_vendor</attribute>
            </xpath>

            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <separator string="Customer Pricing &amp; Webshop"/>
                <group>
                    <group string="Pricing Groups">
                        <field name="sales_group_ids"
                               widget="many2many_tags"
                               domain="[('active','=',True)]"
                               help="At most one group per brand family. Leave empty for guest prices."/>
                        <field name="is_b2b_eu_vat" readonly="1"
                               help="Auto-detected from VAT number + EU country. Grants −5 % on JLR when no JLR group is assigned."/>
                        <field name="baf_max_delivery_weeks"
                               placeholder="No cap"/>
                    </group>
                    <group string="Webshop Brand Visibility">
                        <field name="visible_brand_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Select allowed brands..."/>
                    </group>
                </group>
                <separator string="Vendor"/>
                <group>
                    <field name="baf_is_vendor"/>
                </group>
            </xpath>

            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Vendor Pricing" invisible="not baf_is_vendor">
                    <group>
                        <field name="baf_purchase_method"/>
                        <field name="baf_brand_ids" widget="many2many_tags"/>
                        <label for="baf_delivery_weeks" string="Delivery Time Frame"/>
                        <div class="o_row">
                            <field name="baf_delivery_weeks" nolabel="1" class="oe_inline"/>
                            <span class="mx-1" invisible="baf_delivery_weeks &lt;= 0">-</span>
                            <field name="baf_delivery_weeks_upper" nolabel="1" readonly="1"
                                   class="oe_inline" invisible="baf_delivery_weeks &lt;= 0"/>
                            <span class="ms-1" invisible="baf_delivery_weeks &lt;= 0">weeks</span>
                            <span class="ms-1 text-muted" invisible="baf_delivery_weeks &gt; 0">
                                No delivery time frame
                            </span>
                        </div>
                        <field name="baf_sb_surcharge_pct"
                               invisible="baf_purchase_method != 'matrix'"/>
                        <field name="baf_direct_sale_markup_pct"
                               invisible="baf_purchase_method != 'direct'"/>
                    </group>
                    <div invisible="not baf_purchase_method" class="mt-3">
                        <separator string="Import Pricing Data"/>
                        <div class="text-muted mb-2">
                            Download the template for the selected method, fill in your
                            data, then upload the file and click Import. Importing
                            replaces this vendor's existing pricing.
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button name="action_download_pricing_template" type="object"
                                    string="Download Template" class="btn-secondary"
                                    icon="fa-download"/>
                            <field name="baf_pricing_filename" invisible="1"/>
                            <field name="baf_pricing_file" filename="baf_pricing_filename"
                                   nolabel="1" class="mb-0"/>
                            <button name="action_import_vendor_pricing_file" type="object"
                                    string="Import File" class="btn-primary" icon="fa-upload"
                                    invisible="not baf_pricing_file"/>
                        </div>
                    </div>
                    <field name="baf_purchase_line_ids" invisible="baf_purchase_method != 'matrix'"
                           context="{'default_table_type': 'purchase'}">
                        <list editable="bottom">
                            <field name="column_key"/>
                            <field name="discount_code"/>
                            <field name="discount_pct"/>
                        </list>
                    </field>
                    <field name="baf_code_value_ids" invisible="baf_purchase_method != 'codes'">
                        <list editable="bottom">
                            <field name="code_id"/>
                            <field name="percentage"/>
                        </list>
                    </field>
                    <div invisible="baf_purchase_method != 'direct'" class="mt-3">
                        <separator string="Direct Prices"/>
                        <div class="text-muted mb-2">
                            Too many rows to show here. Open the list to search,
                            filter, sort and edit.
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button name="action_baf_view_direct_prices"
                                    type="object" string="Open Direct Prices"
                                    class="btn-primary" icon="fa-tags"/>
                            <span class="text-muted">
                                <field name="baf_direct_price_count" nolabel="1"
                                       class="oe_inline"/> row(s)
                            </span>
                        </div>
                    </div>
                    <div invisible="baf_purchase_method != 'direct' or not baf_direct_import_ambiguous_ids"
                         class="mt-3">
                        <separator string="Unresolved SKUs from last import"/>
                        <div class="text-muted mb-2">
                            These file rows had a SKU that exists under
                            several brands. Pick the brand per row and click
                            Import Resolved to insert them.
                        </div>
                        <field name="baf_direct_import_ambiguous_ids">
                            <list editable="bottom">
                                <field name="sku" readonly="1"/>
                                <field name="price" readonly="1"/>
                                <field name="file_brand" readonly="1"/>
                                <field name="candidate_brand_ids"
                                       widget="many2many_tags"
                                       readonly="1" optional="show"/>
                                <field name="selected_brand_id"
                                       domain="[('id', 'in', candidate_brand_ids)]"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </list>
                        </field>
                        <div class="mt-2">
                            <button name="action_resolve_direct_import_ambiguous"
                                    type="object"
                                    string="Import Resolved"
                                    class="btn-primary"
                                    icon="fa-check"/>
                        </div>
                    </div>
                </page>
            </xpath>

        </field>
    </record>
</odoo>