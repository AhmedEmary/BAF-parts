<?xml version="1.0" encoding="ISO-8859-1" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:jaxb="http://java.sun.com/xml/ns/jaxb" jaxb:version="2.0"
	xmlns:annox="http://annox.dev.java.net" jaxb:extensionBindingPrefixes="annox">

	<xsd:include schemaLocation="base.xsd" />
	<xsd:include schemaLocation="base-addressline.xsd" />
	<xsd:include schemaLocation="message.xsd" />

	<xsd:element name="order-list-response">
		<xsd:complexType>
			<xsd:annotation>
				<xsd:appinfo>
					<jaxb:class name="order-list-lc31-response-xml" />
					<annox:annotate>
						<annox:annotate annox:class="javax.xml.bind.annotation.XmlRootElement" name="order-list-response" />
					</annox:annotate>
				</xsd:appinfo>
			</xsd:annotation>
			<xsd:complexContent>
				<xsd:extension base="dms-message">
					<xsd:sequence>
						<xsd:element name="dealer-id" type="notemptystring" minOccurs="1" />
						<xsd:element name="country" type="countrycode3" minOccurs="1" />
						<xsd:element name="order" minOccurs="0" maxOccurs="unbounded">
							<xsd:annotation>
								<xsd:appinfo>
									<jaxb:property name="orders"/>
								</xsd:appinfo>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:annotation>
									<xsd:appinfo>
										<jaxb:class name="order" />
									</xsd:appinfo>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:element name="order-id" type="notemptystring" minOccurs="1" />
									<xsd:element name="creation-date" type="date" minOccurs="1" />
									<xsd:element name="editable" type="xsd:boolean" minOccurs="1" />
									<xsd:element name="status" type="notemptystring" minOccurs="0" />
									<xsd:element name="brand" type="xsd:string" minOccurs="1" />
									<xsd:element name="customer-number" type="notemptystring" minOccurs="1" />
									<xsd:element name="customer-ref" type="notemptystring" minOccurs="0" />
									<xsd:element name="customer-name" type="notemptystring" minOccurs="1" />
									<xsd:element name="billing-address" type="address-lines" minOccurs="0" />
									<xsd:element name="delivery-address" type="address-lines" minOccurs="0" />
									<xsd:element name="vin" type="notemptystring" minOccurs="0" />
									<xsd:element name="license-plate" type="notemptystring" minOccurs="0" />
									<xsd:element name="vehicle-registration" type="date" minOccurs="0" />
									<xsd:element name="mileage" type="mileage" minOccurs="0" />
									<xsd:element name="order-type" type="orderType" minOccurs="0" />
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

</xsd:schema>