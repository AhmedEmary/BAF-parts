<?xml version="1.0" encoding="ISO-8859-1" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:jaxb="http://java.sun.com/xml/ns/jaxb" jaxb:version="2.0"
	xmlns:annox="http://annox.dev.java.net" jaxb:extensionBindingPrefixes="annox">

	<xsd:include schemaLocation="base.xsd" />
	<xsd:include schemaLocation="message.xsd" />

	<xsd:element name="commands-available-response">
		<xsd:complexType>
			<xsd:annotation>
				<xsd:appinfo>
					<jaxb:class name="commands-available-lc31-response-xml" />
					<annox:annotate>
						<annox:annotate annox:class="javax.xml.bind.annotation.XmlRootElement" name="commands-available-response" />
					</annox:annotate>
				</xsd:appinfo>
			</xsd:annotation>
			<xsd:complexContent>
				<xsd:extension base="dms-message">
					<xsd:sequence>
						<xsd:element name="command" type="notemptystring" minOccurs="0" maxOccurs="unbounded" />
					</xsd:sequence>
					<xsd:attribute name="dms-name" use="required" type="notemptystring" />
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

</xsd:schema>