<?xml version="1.0" encoding="ISO-8859-1" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:jaxb="http://java.sun.com/xml/ns/jaxb" jaxb:version="2.0"
	xmlns:annox="http://annox.dev.java.net" jaxb:extensionBindingPrefixes="annox">

	<xsd:include schemaLocation="base.xsd" />
	<xsd:include schemaLocation="message.xsd" />

	<xsd:element name="order-append-response">
		<xsd:complexType>
			<xsd:annotation>
				<xsd:appinfo>
					<jaxb:class name="order-append-lc31-response-xml" />
					<annox:annotate>
						<annox:annotate annox:class="javax.xml.bind.annotation.XmlRootElement" name="order-append-response" />
					</annox:annotate>
				</xsd:appinfo>
			</xsd:annotation>
			<xsd:complexContent>
				<xsd:extension base="dms-message">
					<xsd:sequence>
						<xsd:element name="dealer-id" type="notemptystring" minOccurs="1" />
						<xsd:element name="country" type="countrycode3" minOccurs="1" />
						<xsd:element name="order-accepted" type="xsd:boolean" minOccurs="1"/>
						<xsd:element name="order-id" type="notemptystring" minOccurs="0" />
						<xsd:element name="customer-ref" type="notemptystring" minOccurs="0" />
						<xsd:element name="message" type="xsd:string" minOccurs="0"/>
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

</xsd:schema>