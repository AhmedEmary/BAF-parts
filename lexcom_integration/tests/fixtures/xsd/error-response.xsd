<?xml version="1.0" encoding="ISO-8859-1" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:jaxb="http://java.sun.com/xml/ns/jaxb" jaxb:version="2.0"
	xmlns:annox="http://annox.dev.java.net" jaxb:extensionBindingPrefixes="annox">

	<xsd:include schemaLocation="message.xsd" />

	<xsd:element name="error">
		<xsd:complexType>
			<xsd:annotation>
				<xsd:appinfo>
					<jaxb:class name="error-lc31-response-xml" />
					<annox:annotate>
						<annox:annotate annox:class="javax.xml.bind.annotation.XmlRootElement" name="error" />
					</annox:annotate>
				</xsd:appinfo>
			</xsd:annotation>
			<xsd:complexContent>
				<xsd:extension base="dms-message">
					<xsd:sequence>
						<xsd:element name="message" type="xsd:string" />
					</xsd:sequence>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

</xsd:schema>