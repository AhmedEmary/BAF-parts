<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_alzura" model="ir.ui.view">
        <field name="name">sale.order.form.alzura</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_alzura_order" invisible="1"/>
                <field name="alzura_internal_number"
                       invisible="not is_alzura_order"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_alzura" model="ir.ui.view">
        <field name="name">sale.order.list.alzura</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="alzura_internal_number" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_alzura" model="ir.ui.view">
        <field name="name">sale.order.search.alzura</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="alzura_internal_number"/>
            </field>
        </field>
    </record>
</odoo>
